<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="topics.mybatis.mapper.MyBatisOrderCustomerMapper">
    <resultMap id="customerWithOrdersMap" type="MyBatisCustomer">
        <id column="customer_id" property="customerId"/>
        <result column="customer_name" property="name"/>
        <result column="email" property="email"/>
        <result column="phone" property="phone"/>
        <result column="customer_created_at" property="createdAt"/>

        <!--
            collection 表示一个集合属性：JOIN 返回多行订单时，MyBatis 会把这些行组装成 orders 列表。
            这里一个客户对应多个订单，所以使用 collection。
        -->
        <collection property="orders" ofType="MyBatisOrder">
            <id column="order_id" property="orderId"/>
            <result column="order_no" property="orderNo"/>
            <result column="order_customer_id" property="customerId"/>
            <result column="total_amount" property="totalAmount"/>
            <result column="status" property="status"/>
            <result column="order_created_at" property="createdAt"/>
        </collection>
    </resultMap>

    <resultMap id="orderWithCustomerMap" type="MyBatisOrder">
        <id column="order_id" property="orderId"/>
        <result column="order_no" property="orderNo"/>
        <result column="customer_id" property="customerId"/>
        <result column="total_amount" property="totalAmount"/>
        <result column="status" property="status"/>
        <result column="order_created_at" property="createdAt"/>

        <!--
            association 表示一个嵌套对象属性：把当前行中的客户列组装成一个 Customer 对象。
            这里一个订单只对应一个客户，所以使用 association。
        -->
        <association property="customer" javaType="MyBatisCustomer">
            <id column="customer_id" property="customerId"/>
            <result column="customer_name" property="name"/>
            <result column="email" property="email"/>
            <result column="phone" property="phone"/>
            <result column="customer_created_at" property="createdAt"/>
        </association>
    </resultMap>

    <select id="findCustomerWithOrders" resultMap="customerWithOrdersMap">
        SELECT
            c.customer_id,
            c.name AS customer_name,
            c.email,
            c.phone,
            c.created_at AS customer_created_at,
            o.order_id,
            o.order_no,
            o.customer_id AS order_customer_id,
            o.total_amount,
            o.status,
            o.created_at AS order_created_at
        FROM mybatis_customer c
        LEFT JOIN mybatis_order o
            ON o.customer_id = c.customer_id
        WHERE c.email = #{email}
        ORDER BY o.order_id
    </select>

    <select id="findOrderWithCustomer" resultMap="orderWithCustomerMap">
        SELECT
            o.order_id,
            o.order_no,
            o.customer_id,
            o.total_amount,
            o.status,
            o.created_at AS order_created_at,
            c.customer_id,
            c.name AS customer_name,
            c.email,
            c.phone,
            c.created_at AS customer_created_at
        FROM mybatis_order o
        INNER JOIN mybatis_customer c
            ON c.customer_id = o.customer_id
        WHERE o.order_no = #{orderNo}
    </select>
</mapper>
