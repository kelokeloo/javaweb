<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="topics.mybatis.MyBatisStudentMapper">
    <resultMap id="studentSummaryMap" type="MyBatisStudentSummary">
        <id column="student_id" property="id"/>
        <result column="name" property="studentName"/>
        <result column="grade" property="className"/>
        <result column="score" property="score"/>
    </resultMap>

    <select id="findAll" resultType="MyBatisStudent">
        SELECT student_id, name, grade, score FROM mybatis_student ORDER BY student_id
    </select>

    <select id="findAllWithResultMap" resultMap="studentSummaryMap">
        SELECT student_id, name, grade, score FROM mybatis_student ORDER BY student_id
    </select>
</mapper>
