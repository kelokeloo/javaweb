<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE configuration PUBLIC "-//mybatis.org//DTD Config 3.0//EN" "https://mybatis.org/dtd/mybatis-3-config.dtd">
<configuration>
    <properties resource="mybatis-db.properties"/>
    <settings>
        <setting name="mapUnderscoreToCamelCase" value="true"/>
<!--        <setting name="logImpl" value="STDOUT_LOGGING"/>-->
    </settings>
    <typeAliases>
        <!-- 包扫描：该包下所有类自动以「类名简写」注册为别名（大小写不敏感），
             增删实体不用再回来逐条登记 typeAlias -->
        <package name="topics.mybatis.entity"/>
    </typeAliases>
    <environments default="development">
        <environment id="development">
            <transactionManager type="JDBC"/>
            <dataSource type="POOLED">
                <property name="driver" value="${jdbc.driver}"/>
                <property name="url" value="${jdbc.url}"/>
                <property name="username" value="${jdbc.username}"/>
                <property name="password" value="${jdbc.password}"/>
            </dataSource>
        </environment>
    </environments>
    <mappers>
        <!-- 包扫描：注册 topics.mybatis.mapper 下的全部接口。
             接口会在 classpath 同路径（topics/mybatis/mapper/*.xml）自动查找同名 XML；
             没有 XML 的纯注解接口（如 MyBatisAnnotationMapper）则直接解析注解。
             新增 Mapper 不用再回来逐条登记。 -->
        <package name="topics.mybatis.mapper"/>
    </mappers>
</configuration>
